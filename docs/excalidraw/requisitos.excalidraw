      "isDeleted": false,
      "boundElements": null,
      "updated": 1788113472609,
      "link": null,
      "locked": false,
      "text": "Tolerância a falhas: se o machine learning falhar, o envio do questionário\ncontinua valendo.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Tolerância a falhas: se o machine learning falhar, o envio do questionário continua valendo.",
