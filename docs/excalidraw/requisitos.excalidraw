      "isDeleted": false,
      "boundElements": null,
      "updated": 1788112991813,
      "link": null,
      "locked": false,
      "text": "Registro de consentimento dos dados (maior de idade consente sozinho;\nmenor, pelo responsável ou instituição).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Registro de consentimento dos dados (maior de idade consente sozinho; menor, pelo responsável ou instituição).",
      "autoResize": false,
      "lineHeight": 1.25
    },
