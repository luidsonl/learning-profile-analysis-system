      "versionNonce": 803988149,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788114581989,
      "link": null,
      "locked": false,
      "text": "Envios de questionário: as respostas de cada formulário preenchido, sempre com a versão\ndo formulário na hora (para saber como interpretar depois).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Envios de questionário: as respostas de cada formulário preenchido, sempre com a versão do formulário na hora (para saber como interpretar depois).",
      "autoResize": false,
      "lineHeight": 1.25
