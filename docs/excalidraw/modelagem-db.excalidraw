      "updated": 1788114581989,
      "link": null,
      "locked": false,
      "text": "Usuário (responsável, educador, aluno, admin): perfil, e-mail (único), senha, papel e situação\n(ativo/pendente/negado).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Usuário (responsável, educador, aluno, admin): perfil, e-mail (único), senha, papel e situação (ativo/pendente/negado).",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "tCooDUAGwjjp6gT0zj8ko",
      "type": "text",
      "x": -253,
      "y": 424.6071428571429,
      "width": 896.1759905133929,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
