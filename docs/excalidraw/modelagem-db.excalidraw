      "seed": 546246491,
      "version": 126,
      "versionNonce": 861083259,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788114581989,
      "link": null,
      "locked": false,
      "text": "Aluno: a ficha completa (nome, idade, turma, escola), que existe mesmo que ninguém entre\ncomo ele — é um registro, não uma conta.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aluno: a ficha completa (nome, idade, turma, escola), que existe mesmo que ninguém entre como ele — é um registro, não uma conta.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "o7jCntTLHEAmSRkGr2EAS",
