# ============================================================================
# Central resource names (source of truth).
# Safe to commit: no account IDs, no ARNs with account numbers, no secrets.
# Derived from terraform/aws-app outputs; keep in sync with terraform.tfvars.
# Local values (with real queue URL / DynamoDB endpoint) live in env.json
# (git-ignored) and are generated by `make env`.
# ============================================================================
REGION=us-east-1
TABLE_NAME=learning-profile
FILES_BUCKET=learning-profile-files
DATA_BUCKET=learning-profile-data
REPORT_QUEUE_NAME=learning-profile_reports
INFERENCE_MODEL=vark-predictor
MIN_SELF_CONSENT_AGE=18
